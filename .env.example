PORT=4000
# MongoDB. Plain local mongod works (app disables transactions with a warning). For production use Atlas or the docker-compose replica set:
# MONGO_URI=mongodb://127.0.0.1:27017/kingandlioness?replicaSet=rs0
MONGO_URI=mongodb://127.0.0.1:27017/kingandlioness
JWT_SECRET=change-me-to-a-long-random-string-32-chars-or-more
# Any long random string. It encrypts bank account numbers, so keep it safe and never change it later.
ENC_KEY=change-me-another-long-random-string
CLIENT_URL=http://localhost:4200
ADMIN_EMAIL=admin@kingandlioness.local
ADMIN_PASSWORD=ChangeMe@123
